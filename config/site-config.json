{
  "_comment": [
    "Declarative site config applied by scripts/bootstrap/apply-site-config.mjs.",
    "Values mirror the tuning running on the LIVE gateway on 2026-09-12, read back through the same API routes this script writes. Exception: requestQueue.requestsPerMinute 35 and concurrentRequests 5 were set on the Service later that day to stop an NVIDIA request stampede.",
    "The dashboard is the source of truth. After tuning there, update this file to match, because applying a stale copy reverts dashboard changes.",
    "waitForCooldown intentionally omits maxRetryWaitMs/budgetMs: they are derived on read and rejected by the strict write schema."
  ],
  "settings": {
    "resilienceSettings": {
      "requestQueue": {
        "autoEnableApiKeyProviders": true,
        "requestsPerMinute": 35,
        "minTimeBetweenRequestsMs": 0,
        "concurrentRequests": 5,
        "maxWaitMs": 300000,
        "maxQueueDepth": 2000
      },
      "providerBreaker": {
        "oauth": {
          "failureThreshold": 12,
          "degradationThreshold": 7,
          "resetTimeoutMs": 60000
        },
        "apikey": {
          "failureThreshold": 12,
          "degradationThreshold": 7,
          "resetTimeoutMs": 60000
        }
      },
      "waitForCooldown": {
        "enabled": true,
        "maxRetries": 6,
        "maxRetryWaitSec": 15
      },
      "comboCooldownWait": {
        "enabled": true,
        "maxWaitMs": 3000,
        "maxAttempts": 3,
        "budgetMs": 10000
      }
    },
    "comboDefaults": {
      "strategy": "round-robin",
      "maxRetries": 2,
      "retryDelayMs": 2000,
      "fallbackDelayMs": 0,
      "targetTimeoutMs": 300000,
      "handoffThreshold": 0.85,
      "handoffModel": "",
      "maxMessagesForSummary": 30,
      "maxComboDepth": 10,
      "trackMetrics": true,
      "reasoningTokenBufferEnabled": true,
      "zeroLatencyOptimizationsEnabled": false,
      "resetAwareQuotaCacheTtlMs": 30000,
      "resetAwareQuotaCacheMaxStaleMs": 0
    },
    "modelLockout": {
      "enabled": true,
      "errorCodes": [403, 404, 429, 502, 503, 504],
      "baseCooldownMs": 120000,
      "maxCooldownMs": 1800000,
      "maxBackoffSteps": 10,
      "useExponentialBackoff": true
    },
    "fallbackStrategy": "round-robin",
    "localOnlyManageScopeBypassEnabled": true,
    "localOnlyManageScopeBypassPrefixes": ["/api/mcp/"]
  },
  "payloadRules": {
    "default": [
      {
        "models": [
          {
            "name": "MiniMax-M*"
          },
          {
            "name": "*minimax-m*"
          }
        ],
        "params": {
          "thinking": {
            "type": "adaptive"
          },
          "reasoning_effort": "max"
        }
      },
      {
        "models": [
          {
            "name": "*kimi-k3*"
          },
          {
            "name": "k3"
          },
          {
            "name": "k3-*"
          },
          {
            "name": "*kimi-for-coding*"
          },
          {
            "name": "*grok-4*"
          }
        ],
        "params": {
          "reasoning_effort": "max"
        }
      },
      {
        "models": [
          {
            "name": "*glm-5.*"
          },
          {
            "name": "*deepseek-v4*"
          },
          {
            "name": "*deepseek-r*"
          },
          {
            "name": "*kimi-k2.7*"
          }
        ],
        "params": {
          "reasoning_effort": "high"
        }
      }
    ],
    "override": [
      {
        "models": [
          {
            "name": "MiniMax-M*"
          },
          {
            "name": "*minimax-m*"
          }
        ],
        "params": {
          "thinking": {
            "type": "adaptive"
          }
        }
      }
    ],
    "filter": [
      {
        "models": [
          {
            "name": "*kimi-k2.7*",
            "protocol": "github"
          },
          {
            "name": "*kimi-k2.7*",
            "protocol": "gh"
          }
        ],
        "params": ["reasoning_effort"]
      }
    ],
    "defaultRaw": []
  }
}
